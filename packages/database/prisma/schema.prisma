generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LearningRecordStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum LessonType {
  VIDEO
  ARTICLE
  RESOURCE
  LIVE
}

enum EnquirySchool {
  PSYCHOLOGY
  LANGUAGES
  TRAINING
  GENERAL
}

enum EnquiryStatus {
  NEW
  IN_REVIEW
  CONTACTED
  CLOSED
  SPAM
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum LanguageSkill {
  READING
  LISTENING
  SPEAKING
  WRITING
  GRAMMAR
  VOCABULARY
}

enum PlacementAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  REVIEW_REQUIRED
  COMPLETED
  CANCELLED
}

model User {
  id                     String             @id @default(cuid())
  clerkId                String             @unique
  email                  String             @unique
  firstName              String?
  lastName               String?
  imageUrl               String?
  lastSignInAt           DateTime?
  deletedAt              DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  roles                  UserRole[]
  enrollments            Enrollment[]
  records                LearningRecord[]
  certificates           Certificate[]
  enquiryStatusEvents    EnquiryStatusEvent[]
  enrollmentStatusEvents EnrollmentStatusEvent[]
  placementAttempts      PlacementAttempt[] @relation("PlacementLearner")
  placementReviews       PlacementAttempt[] @relation("PlacementReviewer")

  @@index([email])
  @@index([deletedAt])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId      String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Course {
  id                   String                @id @default(cuid())
  sanityId             String                @unique
  slug                 String                @unique
  title                String
  published            Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  modules              CourseModule[]
  enrollments          Enrollment[]
  records              LearningRecord[]
  certificates         Certificate[]
  languageProfile      LanguageCourseProfile?
  placementAssessments PlacementAssessment[]
}

model LanguageCourseProfile {
  id                  String    @id @default(cuid())
  courseId            String    @unique
  targetLanguage      String
  instructionLanguage String
  entryLevel          CefrLevel
  exitLevel           CefrLevel
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  course              Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([targetLanguage, entryLevel])
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  position    Int
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([courseId, position])
  @@index([courseId, published])
}

model Lesson {
  id              String        @id @default(cuid())
  moduleId        String
  slug            String        @unique
  title           String
  summary         String?
  type            LessonType    @default(ARTICLE)
  languageSkill   LanguageSkill?
  cefrLevel       CefrLevel?
  position        Int
  durationMinutes Int?
  contentUrl      String?
  published       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  module          CourseModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, position])
  @@index([moduleId, published])
  @@index([languageSkill, cefrLevel])
}

model PlacementAssessment {
  id             String             @id @default(cuid())
  courseId       String
  title          String
  targetLanguage String
  published      Boolean            @default(false)
  version        Int                @default(1)
  timeLimitMinutes Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  course         Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts       PlacementAttempt[]

  @@unique([courseId, version])
  @@index([targetLanguage, published])
}

model PlacementAttempt {
  id               String                 @id @default(cuid())
  assessmentId     String
  userId           String
  status           PlacementAttemptStatus @default(IN_PROGRESS)
  recommendedLevel CefrLevel?
  totalScore       Decimal?               @db.Decimal(5, 2)
  startedAt        DateTime               @default(now())
  submittedAt      DateTime?
  completedAt      DateTime?
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  assessment       PlacementAssessment    @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  user             User                   @relation("PlacementLearner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy       User?                  @relation("PlacementReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  skillResults     PlacementSkillResult[]

  @@index([userId, status, startedAt])
  @@index([assessmentId, status])
  @@index([reviewedById, reviewedAt])
}

model PlacementSkillResult {
  id        String        @id @default(cuid())
  attemptId String
  skill     LanguageSkill
  score     Decimal       @db.Decimal(5, 2)
  level     CefrLevel?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  attempt   PlacementAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, skill])
  @@index([skill, level])
}

model Enrollment {
  id           String                  @id @default(cuid())
  userId       String
  courseId     String
  status       EnrollmentStatus        @default(PENDING)
  enrolledAt   DateTime                @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  expiresAt    DateTime?
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  statusEvents EnrollmentStatusEvent[]

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@index([userId, status])
}

model EnrollmentStatusEvent {
  id           String            @id @default(cuid())
  enrollmentId String
  actorUserId  String
  fromStatus   EnrollmentStatus?
  toStatus     EnrollmentStatus
  createdAt    DateTime          @default(now())
  enrollment   Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  actor        User              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([enrollmentId, createdAt])
  @@index([actorUserId, createdAt])
}

model LearningRecord {
  id             String               @id @default(cuid())
  userId         String
  courseId       String
  lessonId       String
  status         LearningRecordStatus @default(NOT_STARTED)
  progress       Int                  @default(0)
  score          Decimal?             @db.Decimal(5, 2)
  startedAt      DateTime?
  completedAt    DateTime?
  lastActivityAt DateTime             @default(now())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course               @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId, lessonId])
  @@index([courseId, lessonId])
  @@index([userId, status])
}

model Certificate {
  id              String   @id @default(cuid())
  verificationId  String   @unique @default(cuid())
  userId          String
  courseId        String
  issuedAt        DateTime @default(now())
  revokedAt       DateTime?
  publiclyVisible Boolean  @default(false)
  recipientName   String?
  metadata        Json?
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([courseId, issuedAt])
}

model Enquiry {
  id           String               @id @default(cuid())
  name         String
  email        String
  phone        String?
  school       EnquirySchool
  message      String
  locale       String               @default("en")
  consent      Boolean
  status       EnquiryStatus        @default(NEW)
  source       String               @default("website")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  statusEvents EnquiryStatusEvent[]

  @@index([status, createdAt])
  @@index([email])
}

model EnquiryStatusEvent {
  id          String        @id @default(cuid())
  enquiryId   String
  actorUserId String
  fromStatus  EnquiryStatus
  toStatus    EnquiryStatus
  createdAt   DateTime      @default(now())
  enquiry     Enquiry       @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  actor       User          @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([enquiryId, createdAt])
  @@index([actorUserId, createdAt])
}
