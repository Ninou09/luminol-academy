generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SearchSurface {
  LEARNER
  PUBLIC_PROGRAMMES
  ADMIN
}

enum SearchOutcome {
  HIT
  NO_MATCH
}

enum SearchResultBucket {
  ZERO
  ONE_TO_FIVE
  SIX_TO_TWENTY
  TWENTY_PLUS
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LearningRecordStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum LessonType {
  VIDEO
  ARTICLE
  RESOURCE
  LIVE
}

enum EnquirySchool {
  PSYCHOLOGY
  LANGUAGES
  TRAINING
  GENERAL
}

enum EnquiryStatus {
  NEW
  IN_REVIEW
  CONTACTED
  CLOSED
  SPAM
}

enum EnquiryContactPreference {
  EMAIL
  PHONE
  WHATSAPP
}

enum EnquiryDeliveryPreference {
  IN_PERSON
  ONLINE
  FLEXIBLE
  NOT_SURE
}

enum EnquiryTimingPreference {
  SOON
  WITHIN_MONTH
  LATER
  NOT_SURE
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum LanguageSkill {
  READING
  LISTENING
  SPEAKING
  WRITING
  GRAMMAR
  VOCABULARY
}

enum PlacementAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  REVIEW_REQUIRED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  PAST_DUE
  REFUNDED
}

enum PaymentIntentStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentTransactionType {
  CHARGE
  REFUND
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_TIME
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  DISCREPANCY
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationCategory {
  TRANSACTIONAL
  MARKETING
}

enum NotificationStatus {
  PENDING
  PROCESSING
  DELIVERED
  RETRY_SCHEDULED
  DEAD_LETTER
  CANCELLED
}

enum NotificationAttemptStatus {
  SUCCEEDED
  FAILED
}

enum CertificateStatus {
  ACTIVE
  REVOKED
  SUPERSEDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationMembershipRole {
  OWNER
  MANAGER
  LEARNER
}

enum OrganizationSeatStatus {
  INVITED
  ACTIVE
  COMPLETED
  REVOKED
}

enum CohortStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CohortInstructorRole {
  LEAD
  ASSISTANT
  REVIEWER
}

enum CohortSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CohortAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AiOperatorProposalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum AiOperatorProposalEventType {
  PROPOSED
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id                          String                       @id @default(cuid())
  clerkId                     String                       @unique
  email                       String                       @unique
  firstName                   String?
  lastName                    String?
  imageUrl                    String?
  lastSignInAt                DateTime?
  deletedAt                   DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  roles                       UserRole[]
  enrollments                 Enrollment[]
  records                     LearningRecord[]
  certificates                Certificate[]
  assignedEnquiries           Enquiry[]                    @relation("EnquiryOwner")
  enquiryStatusEvents         EnquiryStatusEvent[]
  enquiryOwnershipEvents      EnquiryOwnershipEvent[]      @relation("EnquiryOwnershipActor")
  enquiryFollowUpEvents       EnquiryFollowUpEvent[]       @relation("EnquiryFollowUpActor")
  enquiryOutcomeEvents        EnquiryOutcomeEvent[]        @relation("EnquiryOutcomeActor")
  enrollmentStatusEvents      EnrollmentStatusEvent[]
  placementAttempts           PlacementAttempt[]           @relation("PlacementLearner")
  placementReviews            PlacementAttempt[]           @relation("PlacementReviewer")
  invoices                    Invoice[]                    @relation("InvoiceCustomer")
  subscriptions               Subscription[]
  financeAuditEvents          FinanceAuditEvent[]          @relation("FinanceAuditActor")
  notifications               Notification[]
  notificationPreferences     NotificationPreference[]
  notificationEvents          NotificationEvent[]
  certificateAuditEvents      CertificateAuditEvent[]      @relation("CertificateAuditActor")
  certificateRevocations      CertificateRevocation[]      @relation("CertificateRevocationActor")
  organizationMemberships     OrganizationMembership[]
  organizationSeats           OrganizationSeat[]
  cohortInstructorAssignments CohortInstructorAssignment[]
  cohortDeliveryAuditEvents   CohortDeliveryAuditEvent[]   @relation("CohortDeliveryAuditActor")
  cohortAttendanceRecords     CohortSessionAttendance[]    @relation("CohortAttendanceRecorder")

  aiOperatorProposalsProposed AiOperatorProposal[]      @relation("AiOperatorProposalProposer")
  aiOperatorProposalsDecided  AiOperatorProposal[]      @relation("AiOperatorProposalDecider")
  aiOperatorProposalEvents    AiOperatorProposalEvent[] @relation("AiOperatorProposalEventActor")

  organizationAuditEvents OrganizationAuditEvent[] @relation("OrganizationAuditActor")

  @@index([email])
  @@index([deletedAt])
}

model AiOperatorProposal {
  id               String                    @id @default(cuid())
  actionId         String                    @unique
  actionVersion    String
  actionKind       String
  executionPolicy  String
  sourceSurface    String
  sourceReference  String
  actionEnvelope   Json
  status           AiOperatorProposalStatus  @default(PENDING_APPROVAL)
  proposedByUserId String?
  decidedByUserId  String?
  decidedAt        DateTime?
  decisionNote     String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  proposedBy       User?                     @relation("AiOperatorProposalProposer", fields: [proposedByUserId], references: [id], onDelete: SetNull)
  decidedBy        User?                     @relation("AiOperatorProposalDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  events           AiOperatorProposalEvent[]

  @@index([status, createdAt])
  @@index([actionKind, status, createdAt])
  @@index([proposedByUserId, createdAt])
  @@index([decidedByUserId, decidedAt])
}

model AiOperatorProposalEvent {
  id          String                      @id @default(cuid())
  proposalId  String
  eventType   AiOperatorProposalEventType
  actorUserId String?
  fromStatus  AiOperatorProposalStatus?
  toStatus    AiOperatorProposalStatus
  note        String?
  occurredAt  DateTime                    @default(now())
  proposal    AiOperatorProposal          @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  actor       User?                       @relation("AiOperatorProposalEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([proposalId, occurredAt])
  @@index([actorUserId, occurredAt])
}

model Invoice {
  id                   String                  @id @default(cuid())
  number               String                  @unique
  customerId           String
  organizationId       String?
  organizationRecordId String?
  status               InvoiceStatus           @default(DRAFT)
  currency             String                  @db.Char(3)
  discountMinor        Int                     @default(0)
  taxRateBasisPoints   Int                     @default(0)
  subtotalMinor        Int
  taxMinor             Int
  totalMinor           Int
  dueAt                DateTime?
  paidAt               DateTime?
  voidedAt             DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  customer             User                    @relation("InvoiceCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  organizationRecord   Organization?           @relation("VerifiedInvoiceOrganization", fields: [organizationRecordId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lines                InvoiceLineItem[]
  paymentIntents       PaymentIntent[]
  receipts             Receipt[]
  corporateBilling     CorporateBillingRecord?
  subscriptions        Subscription[]

  @@index([customerId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationRecordId, status, createdAt])
}

model InvoiceLineItem {
  id              String   @id @default(cuid())
  invoiceId       String
  description     String
  quantity        Int
  unitAmountMinor Int
  lineTotalMinor  Int
  createdAt       DateTime @default(now())
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model PaymentIntent {
  id                String                 @id @default(cuid())
  invoiceId         String
  customerId        String
  amountMinor       Int
  currency          String                 @db.Char(3)
  status            PaymentIntentStatus    @default(REQUIRES_PAYMENT_METHOD)
  provider          String
  providerReference String?
  idempotencyKey    String                 @unique
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  invoice           Invoice                @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  transactions      PaymentTransaction[]
  refunds           Refund[]
  receipts          Receipt[]
  reconciliations   ReconciliationRecord[]

  @@unique([provider, providerReference])
  @@index([invoiceId, status])
  @@index([customerId, createdAt])
}

model PaymentTransaction {
  id                String                   @id @default(cuid())
  paymentIntentId   String
  type              PaymentTransactionType
  status            PaymentTransactionStatus
  amountMinor       Int
  currency          String                   @db.Char(3)
  providerReference String?
  idempotencyKey    String                   @unique
  occurredAt        DateTime                 @default(now())
  createdAt         DateTime                 @default(now())
  paymentIntent     PaymentIntent            @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  refund            Refund?

  @@unique([providerReference, type])
  @@index([paymentIntentId, occurredAt])
}

model Refund {
  id                String                   @id @default(cuid())
  paymentIntentId   String
  transactionId     String?                  @unique
  amountMinor       Int
  currency          String                   @db.Char(3)
  reason            String?
  status            PaymentTransactionStatus @default(PENDING)
  providerReference String?                  @unique
  idempotencyKey    String                   @unique
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  paymentIntent     PaymentIntent            @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  transaction       PaymentTransaction?      @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([paymentIntentId, status])
}

model Receipt {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique
  invoiceId       String
  paymentIntentId String
  customerId      String
  currency        String        @db.Char(3)
  subtotalMinor   Int
  discountMinor   Int
  taxMinor        Int
  totalMinor      Int
  issuedAt        DateTime      @default(now())
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)

  @@unique([paymentIntentId])
  @@index([customerId, issuedAt])
}

model PricingPlan {
  id              String          @id @default(cuid())
  code            String          @unique
  name            String
  amountMinor     Int
  currency        String          @db.Char(3)
  billingInterval BillingInterval
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  subscriptions   Subscription[]

  @@index([active, billingInterval])
}

model Coupon {
  id             String             @id @default(cuid())
  code           String             @unique
  percentOff     Int?
  amountOffMinor Int?
  currency       String?            @db.Char(3)
  maxRedemptions Int?
  redeemedCount  Int                @default(0)
  active         Boolean            @default(true)
  expiresAt      DateTime?
  createdAt      DateTime           @default(now())
  redemptions    CouponRedemption[]

  @@index([active, expiresAt])
}

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  customerId    String
  invoiceId     String
  discountMinor Int
  redeemedAt    DateTime @default(now())
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)

  @@unique([couponId, invoiceId])
  @@index([customerId, redeemedAt])
}

model Subscription {
  id                 String             @id @default(cuid())
  customerId         String
  pricingPlanId      String
  latestInvoiceId    String?
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  providerReference  String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  customer           User               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pricingPlan        PricingPlan        @relation(fields: [pricingPlanId], references: [id], onDelete: Restrict)
  latestInvoice      Invoice?           @relation(fields: [latestInvoiceId], references: [id], onDelete: SetNull)

  @@index([customerId, status])
  @@index([status, currentPeriodEnd])
}

model ReconciliationRecord {
  id                String               @id @default(cuid())
  paymentIntentId   String
  provider          String
  providerReference String
  grossMinor        Int
  feeMinor          Int                  @default(0)
  netMinor          Int
  ledgerMinor       Int
  differenceMinor   Int
  currency          String               @db.Char(3)
  status            ReconciliationStatus @default(PENDING)
  settledAt         DateTime
  reconciledAt      DateTime?
  createdAt         DateTime             @default(now())
  paymentIntent     PaymentIntent        @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerReference])
  @@index([status, settledAt])
  @@index([paymentIntentId])
}

model FinanceAuditEvent {
  id             String   @id @default(cuid())
  entityType     String
  entityId       String
  action         String
  actorUserId    String?
  idempotencyKey String?  @unique
  metadata       Json
  occurredAt     DateTime @default(now())
  actor          User?    @relation("FinanceAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
}

model CorporateBillingRecord {
  id                     String        @id @default(cuid())
  organizationId         String
  organizationRecordId   String?
  invoiceId              String        @unique
  billingContactName     String
  billingContactEmail    String
  purchaseOrderReference String?
  seatCount              Int
  pricePerSeatMinor      Int
  paymentTermsDays       Int
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  invoice                Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  organizationRecord     Organization? @relation("VerifiedCorporateBillingOrganization", fields: [organizationRecordId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationRecordId, createdAt])
  @@index([purchaseOrderReference])
}

model Organization {
  id                      String                   @id @default(cuid())
  name                    String
  status                  OrganizationStatus       @default(ACTIVE)
  seatLimit               Int
  archivedAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  memberships             OrganizationMembership[]
  teams                   Team[]
  seats                   OrganizationSeat[]
  courses                 OrganizationCourse[]
  financeInvoices         Invoice[]                @relation("VerifiedInvoiceOrganization")
  corporateBillingRecords CorporateBillingRecord[] @relation("VerifiedCorporateBillingOrganization")
  notificationEvents      NotificationEvent[]      @relation("VerifiedNotificationEventOrganization")
  notifications           Notification[]           @relation("VerifiedNotificationOrganization")

  auditEvents OrganizationAuditEvent[]

  @@index([status, name])
  @@index([archivedAt])
}

model OrganizationMembership {
  id              String                     @id @default(cuid())
  organizationId  String
  userId          String
  role            OrganizationMembershipRole
  active          Boolean
  joinedAt        DateTime                   @default(now())
  endedAt         DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamMemberships TeamMembership[]

  @@unique([organizationId, userId])
  @@index([userId, active])
  @@index([organizationId, role, active])
}

model Team {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships    TeamMembership[]

  @@unique([organizationId, name])
  @@index([organizationId, archivedAt])
}

model TeamMembership {
  id                       String                 @id @default(cuid())
  teamId                   String
  organizationMembershipId String
  createdAt                DateTime               @default(now())
  team                     Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  organizationMembership   OrganizationMembership @relation(fields: [organizationMembershipId], references: [id], onDelete: Cascade)

  @@unique([teamId, organizationMembershipId])
  @@index([organizationMembershipId, teamId])
}

model OrganizationSeat {
  id             String                 @id @default(cuid())
  organizationId String
  userId         String
  status         OrganizationSeatStatus @default(INVITED)
  invitedAt      DateTime               @default(now())
  activatedAt    DateTime?
  completedAt    DateTime?
  revokedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId, status])
}

model OrganizationCourse {
  id             String                              @id @default(cuid())
  organizationId String
  courseId       String
  active         Boolean                             @default(true)
  assignedAt     DateTime                            @default(now())
  unassignedAt   DateTime?
  createdAt      DateTime                            @default(now())
  updatedAt      DateTime                            @updatedAt
  organization   Organization                        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  course         Course                              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  sponsorships   OrganizationEnrollmentSponsorship[]

  @@unique([organizationId, courseId])
  @@index([organizationId, active, assignedAt])
  @@index([courseId, active])
}

model OrganizationEnrollmentSponsorship {
  id                   String             @id @default(cuid())
  organizationCourseId String
  enrollmentId         String
  active               Boolean            @default(true)
  sponsoredAt          DateTime           @default(now())
  endedAt              DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  organizationCourse   OrganizationCourse @relation(fields: [organizationCourseId], references: [id], onDelete: Restrict)
  enrollment           Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@index([organizationCourseId, active])
  @@index([enrollmentId, active])
}

model OrganizationAuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String
  action         String
  subjectType    String
  subjectId      String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User         @relation("OrganizationAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([subjectType, subjectId, createdAt])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Course {
  id                   String                 @id @default(cuid())
  sanityId             String                 @unique
  slug                 String                 @unique
  title                String
  published            Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  modules              CourseModule[]
  enrollments          Enrollment[]
  records              LearningRecord[]
  certificates         Certificate[]
  languageProfile      LanguageCourseProfile?
  placementAssessments PlacementAssessment[]
  organizationCourses  OrganizationCourse[]
  cohorts              Cohort[]

  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Course_title_trgm_idx")
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "Course_slug_trgm_idx")
}

model Cohort {
  id                    String                       @id @default(cuid())
  courseId              String
  name                  String
  status                CohortStatus                 @default(PLANNED)
  startsAt              DateTime?
  endsAt                DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  course                Course                       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  instructorAssignments CohortInstructorAssignment[]
  enrollments           CohortEnrollment[]
  sessions              CohortSession[]
  auditEvents           CohortDeliveryAuditEvent[]

  @@index([courseId, status])
  @@index([status, startsAt])
}

model CohortInstructorAssignment {
  id               String               @id @default(cuid())
  cohortId         String
  instructorUserId String
  role             CohortInstructorRole
  active           Boolean              @default(true)
  assignedAt       DateTime             @default(now())
  endedAt          DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  cohort           Cohort               @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  instructor       User                 @relation(fields: [instructorUserId], references: [id], onDelete: Restrict)

  @@index([instructorUserId, active])
  @@index([cohortId, active, role])
}

model CohortEnrollment {
  id                String                    @id @default(cuid())
  cohortId          String
  enrollmentId      String
  active            Boolean                   @default(true)
  joinedAt          DateTime                  @default(now())
  endedAt           DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  cohort            Cohort                    @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  enrollment        Enrollment                @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  attendanceRecords CohortSessionAttendance[]

  @@index([enrollmentId, active])
  @@index([cohortId, active])
}

model CohortSession {
  id         String                    @id @default(cuid())
  cohortId   String
  title      String?
  status     CohortSessionStatus       @default(SCHEDULED)
  startsAt   DateTime
  endsAt     DateTime
  timeZone   String
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  cohort     Cohort                    @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  attendance CohortSessionAttendance[]

  @@index([cohortId, status, startsAt])
  @@index([startsAt, status])
}

model CohortSessionAttendance {
  id                 String                 @id @default(cuid())
  sessionId          String
  cohortEnrollmentId String
  status             CohortAttendanceStatus
  recordedByUserId   String
  recordedAt         DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  session            CohortSession          @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  cohortEnrollment   CohortEnrollment       @relation(fields: [cohortEnrollmentId], references: [id], onDelete: Restrict)
  recordedBy         User                   @relation("CohortAttendanceRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@unique([sessionId, cohortEnrollmentId])
  @@index([cohortEnrollmentId, recordedAt])
  @@index([sessionId, status])
  @@index([recordedByUserId, recordedAt])
}

model LanguageCourseProfile {
  id                  String    @id @default(cuid())
  courseId            String    @unique
  targetLanguage      String
  instructionLanguage String
  entryLevel          CefrLevel
  exitLevel           CefrLevel
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  course              Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([targetLanguage, entryLevel])
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  position    Int
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([courseId, position])
  @@index([courseId, published])
}

model Lesson {
  id              String         @id @default(cuid())
  moduleId        String
  slug            String         @unique
  title           String
  summary         String?
  type            LessonType     @default(ARTICLE)
  languageSkill   LanguageSkill?
  cefrLevel       CefrLevel?
  position        Int
  durationMinutes Int?
  contentUrl      String?
  published       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  module          CourseModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, position])
  @@index([moduleId, published])
  @@index([languageSkill, cefrLevel])
}

model PlacementAssessment {
  id               String             @id @default(cuid())
  courseId         String
  title            String
  targetLanguage   String
  published        Boolean            @default(false)
  version          Int                @default(1)
  timeLimitMinutes Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  course           Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts         PlacementAttempt[]

  @@unique([courseId, version])
  @@index([targetLanguage, published])
}

model PlacementAttempt {
  id               String                 @id @default(cuid())
  assessmentId     String
  userId           String
  status           PlacementAttemptStatus @default(IN_PROGRESS)
  recommendedLevel CefrLevel?
  totalScore       Decimal?               @db.Decimal(5, 2)
  startedAt        DateTime               @default(now())
  submittedAt      DateTime?
  completedAt      DateTime?
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  assessment       PlacementAssessment    @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  user             User                   @relation("PlacementLearner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy       User?                  @relation("PlacementReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  skillResults     PlacementSkillResult[]

  @@index([userId, status, startedAt])
  @@index([assessmentId, status])
  @@index([reviewedById, reviewedAt])
}

model PlacementSkillResult {
  id        String           @id @default(cuid())
  attemptId String
  skill     LanguageSkill
  score     Decimal          @db.Decimal(5, 2)
  level     CefrLevel?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  attempt   PlacementAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, skill])
  @@index([skill, level])
}

model Enrollment {
  id                       String                              @id @default(cuid())
  userId                   String
  courseId                 String
  status                   EnrollmentStatus                    @default(PENDING)
  enrolledAt               DateTime                            @default(now())
  startedAt                DateTime?
  completedAt              DateTime?
  expiresAt                DateTime?
  user                     User                                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course                   Course                              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  statusEvents             EnrollmentStatusEvent[]
  organizationSponsorships OrganizationEnrollmentSponsorship[]
  cohortEnrollments        CohortEnrollment[]

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@index([userId, status])
}

model EnrollmentStatusEvent {
  id           String            @id @default(cuid())
  enrollmentId String
  actorUserId  String
  fromStatus   EnrollmentStatus?
  toStatus     EnrollmentStatus
  createdAt    DateTime          @default(now())
  enrollment   Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  actor        User              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([enrollmentId, createdAt])
  @@index([actorUserId, createdAt])
}

model LearningRecord {
  id             String               @id @default(cuid())
  userId         String
  courseId       String
  lessonId       String
  status         LearningRecordStatus @default(NOT_STARTED)
  progress       Int                  @default(0)
  score          Decimal?             @db.Decimal(5, 2)
  startedAt      DateTime?
  completedAt    DateTime?
  lastActivityAt DateTime             @default(now())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course               @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId, lessonId])
  @@index([courseId, lessonId])
  @@index([userId, status])
}

model Certificate {
  id                    String                  @id @default(cuid())
  verificationId        String                  @unique @default(cuid())
  userId                String
  courseId              String
  issuedAt              DateTime                @default(now())
  revokedAt             DateTime?
  publiclyVisible       Boolean                 @default(false)
  recipientName         String?
  metadata              Json?
  serialNumber          String                  @unique @default(cuid())
  completionId          String?                 @unique
  status                CertificateStatus       @default(ACTIVE)
  recipientNameSnapshot String?
  courseTitleSnapshot   String?
  issuerNameSnapshot    String                  @default("Luminol Academy")
  snapshot              Json?
  replacedById          String?                 @unique
  replacementFor        Certificate?            @relation("CertificateReplacement", fields: [replacedById], references: [id], onDelete: Restrict)
  replacement           Certificate?            @relation("CertificateReplacement")
  revocation            CertificateRevocation?
  auditEvents           CertificateAuditEvent[]
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  course                Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([userId, courseId, status])
  @@index([courseId, issuedAt])
}

model NotificationPreference {
  id                String               @id @default(cuid())
  userId            String
  organizationId    String?
  channel           NotificationChannel
  category          NotificationCategory
  enabled           Boolean              @default(true)
  timeZone          String               @default("UTC")
  quietStartMinutes Int?
  quietEndMinutes   Int?
  consentedAt       DateTime?
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId, channel, category])
  @@index([organizationId, userId])
}

model NotificationEvent {
  id                   String               @id @default(cuid())
  idempotencyKey       String               @unique
  organizationId       String?
  organizationRecordId String?
  recipientId          String
  templateKey          String
  category             NotificationCategory
  payload              Json
  createdAt            DateTime             @default(now())
  recipient            User                 @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  organizationRecord   Organization?        @relation("VerifiedNotificationEventOrganization", fields: [organizationRecordId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  notifications        Notification[]

  @@index([organizationId, recipientId, createdAt])
  @@index([organizationRecordId, recipientId, createdAt])
}

model Notification {
  id                   String                        @id @default(cuid())
  eventId              String
  recipientId          String
  organizationId       String?
  organizationRecordId String?
  channel              NotificationChannel
  status               NotificationStatus            @default(PENDING)
  title                String
  preview              String
  body                 String
  provider             String?
  providerReference    String?
  attemptCount         Int                           @default(0)
  scheduledAt          DateTime                      @default(now())
  deliveredAt          DateTime?
  readAt               DateTime?
  lastErrorCode        String?
  lockToken            String?                       @unique
  lockedUntil          DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  event                NotificationEvent             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipient            User                          @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  organizationRecord   Organization?                 @relation("VerifiedNotificationOrganization", fields: [organizationRecordId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attempts             NotificationDeliveryAttempt[]
  auditEvents          NotificationAuditEvent[]

  @@unique([eventId, channel])
  @@unique([provider, providerReference])
  @@index([recipientId, readAt, createdAt])
  @@index([status, scheduledAt])
  @@index([organizationId, status, scheduledAt])
  @@index([organizationRecordId, status, scheduledAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  windowEnd DateTime
  updatedAt DateTime @updatedAt

  @@index([windowEnd])
}

model NotificationDeliveryAttempt {
  id                String                    @id @default(cuid())
  notificationId    String
  attemptNumber     Int
  status            NotificationAttemptStatus
  providerReference String?
  errorCode         String?
  attemptedAt       DateTime                  @default(now())
  notification      Notification              @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, attemptNumber])
  @@index([status, attemptedAt])
}

model NotificationAuditEvent {
  id             String       @id @default(cuid())
  notificationId String
  action         String
  metadata       Json
  occurredAt     DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, occurredAt])
}

model CertificateRevocation {
  id            String      @id @default(cuid())
  certificateId String      @unique
  actorUserId   String
  reasonCode    String
  reason        String?
  revokedAt     DateTime    @default(now())
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  actor         User        @relation("CertificateRevocationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
}

model CertificateAuditEvent {
  id            String      @id @default(cuid())
  certificateId String
  actorUserId   String?
  action        String
  metadata      Json
  occurredAt    DateTime    @default(now())
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  actor         User?       @relation("CertificateAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([certificateId, occurredAt])
  @@index([actorUserId, occurredAt])
}

model Enquiry {
  id                     String                     @id @default(cuid())
  name                   String
  email                  String
  phone                  String?
  city                   String?
  preferredContact       EnquiryContactPreference?
  deliveryPreference     EnquiryDeliveryPreference?
  timingPreference       EnquiryTimingPreference?
  school                 EnquirySchool
  programmeSlug          String?
  programmeTitleSnapshot String?
  message                String
  locale                 String                     @default("en")
  consent                Boolean
  status                 EnquiryStatus              @default(NEW)
  source                 String                     @default("website")
  landingPath            String?
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  utmContent             String?
  ownerUserId            String?
  nextFollowUpAt         DateTime?
  nextAction             String?
  outcome                String?
  outcomeAt              DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  owner                  User?                      @relation("EnquiryOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  statusEvents           EnquiryStatusEvent[]
  ownershipEvents        EnquiryOwnershipEvent[]
  followUpEvents         EnquiryFollowUpEvent[]
  outcomeEvents          EnquiryOutcomeEvent[]

  @@index([status, createdAt])
  @@index([ownerUserId, status, createdAt])
  @@index([nextFollowUpAt, status])
  @@index([programmeSlug, createdAt])
  @@index([utmSource, utmCampaign, createdAt])
  @@index([email])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Enquiry_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Enquiry_email_trgm_idx")
}

model EnquiryStatusEvent {
  id          String        @id @default(cuid())
  enquiryId   String
  actorUserId String
  fromStatus  EnquiryStatus
  toStatus    EnquiryStatus
  createdAt   DateTime      @default(now())
  enquiry     Enquiry       @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  actor       User          @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([enquiryId, createdAt])
  @@index([actorUserId, createdAt])
}

model EnquiryOwnershipEvent {
  id              String   @id @default(cuid())
  enquiryId       String
  actorUserId     String
  fromOwnerUserId String?
  toOwnerUserId   String?
  createdAt       DateTime @default(now())
  enquiry         Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  actor           User     @relation("EnquiryOwnershipActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([enquiryId, createdAt])
  @@index([actorUserId, createdAt])
}

model EnquiryFollowUpEvent {
  id                 String    @id @default(cuid())
  enquiryId          String
  actorUserId        String
  fromNextFollowUpAt DateTime?
  toNextFollowUpAt   DateTime?
  fromNextAction     String?
  toNextAction       String?
  createdAt          DateTime  @default(now())
  enquiry            Enquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  actor              User      @relation("EnquiryFollowUpActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([enquiryId, createdAt])
  @@index([actorUserId, createdAt])
}

model EnquiryOutcomeEvent {
  id            String    @id @default(cuid())
  enquiryId     String
  actorUserId   String
  fromOutcome   String?
  toOutcome     String?
  fromOutcomeAt DateTime?
  toOutcomeAt   DateTime?
  createdAt     DateTime  @default(now())
  enquiry       Enquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  actor         User      @relation("EnquiryOutcomeActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([enquiryId, createdAt])
  @@index([actorUserId, createdAt])
}

model SearchTelemetryDaily {
  id           String             @id @default(cuid())
  day          DateTime           @db.Date
  surface      SearchSurface
  outcome      SearchOutcome
  resultBucket SearchResultBucket
  count        Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([day, surface, outcome, resultBucket])
  @@index([surface, day])
}

model CohortDeliveryAuditEvent {
  id          String   @id
  cohortId    String
  actorUserId String
  action      String
  subjectType String
  subjectId   String
  occurredAt  DateTime @default(now())
  cohort      Cohort   @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  actor       User     @relation("CohortDeliveryAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([cohortId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([subjectType, subjectId, occurredAt])
}
