{
  "name": "@luminol/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./content-calendar": "./src/content-calendar.ts",
    "./social-publishing-attempts": "./src/social-publishing-attempts.ts",
    "./social-publishing-delivery": "./src/social-publishing-delivery.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "backfill:m16-organization-links": "node scripts/backfill-milestone16-organization-links.mjs",
    "verify:m16-organization-links": "node scripts/verify-milestone16-organization-links.mjs",
    "studio": "prisma studio",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@luminol/validation": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "^8.22.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@luminol/config": "workspace:*",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.9.1",
    "prisma": "7.9.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
