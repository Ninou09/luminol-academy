{
  "name": "@luminol/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsc --outDir dist --noEmit false && node dist/main.js",
    "run:once": "tsc --outDir dist --noEmit false && node dist/main.js --once",
    "start:social": "tsc --outDir dist --noEmit false && node dist/social-main.js",
    "run:social:once": "tsc --outDir dist --noEmit false && node dist/social-main.js --once",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@luminol/database": "workspace:*",
    "@luminol/notifications": "workspace:*",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@luminol/config": "workspace:*"
  }
}
