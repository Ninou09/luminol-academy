DATABASE_URL="postgresql://luminol:luminol_local@localhost:5432/luminol?schema=public"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"
CLERK_WEBHOOK_SECRET="whsec_replace_me"
NEXT_PUBLIC_SANITY_PROJECT_ID="replace-me"
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN="replace-me"
RESEND_API_KEY="re_replace_me"
NOTIFICATION_FROM_EMAIL="notifications@example.com"
NOTIFICATION_PROVIDER_TIMEOUT_MS="30000"
NOTIFICATION_WORKER_BATCH_SIZE="25"
NOTIFICATION_WORKER_INTERVAL_MS="5000"
# Optional for both the scheduled run-once worker and a continuously hosted worker.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Scheduled social publishing has an independent switch and remains OFF by default.
# INSTAGRAM_REELS_DUE consumes only already-approved/planned, due scheduled Reels;
# the executor still revalidates the exact proposal, content revision and account.
LUMINOL_SOCIAL_PUBLISHING_WORKER_MODE="OFF"
LUMINOL_SOCIAL_PUBLISHING_WORKER_BATCH_SIZE="10"
LUMINOL_SOCIAL_PUBLISHING_WORKER_INTERVAL_MS="15000"

# Meta delivery is also disabled unless an operator explicitly selects INSTAGRAM_REELS.
# Scheduled dispatch therefore requires both opt-in switches. Keep the access token
# server-side only; never prefix it with NEXT_PUBLIC_.
LUMINOL_META_PUBLISHING_MODE="OFF"
LUMINOL_META_GRAPH_VERSION=""
LUMINOL_META_ACCESS_TOKEN=""
LUMINOL_META_REQUEST_TIMEOUT_MS="10000"
