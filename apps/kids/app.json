{
  "expo": {
    "name": "Luminol Noor",
    "slug": "luminol-noor",
    "scheme": "luminolnoor",
    "version": "0.1.0",
    "icon": "./assets/brand/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "backgroundColor": "#F5F1EA",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.luminolacademy.noor",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon-foreground.png",
        "backgroundColor": "#2F6B69"
      },
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      "expo-audio"
    ]
  }
}
